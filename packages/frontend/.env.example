# Public variables for local Next.js. The full list, including Neon and JWT_SECRET,
# lives in the repository root .env.example. Never commit real secrets.

# Leave empty to call this app's /api routes.
NEXT_PUBLIC_API_URL=

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_MAP_PROVIDER=mapbox
NEXT_PUBLIC_ENABLE_PWA=true
