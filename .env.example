# Mile Quest environment template
# Copy to .env.local for local development. On Vercel, set these in Project Settings.
# Never commit real secrets. Values below are placeholders.

# ======================
# Frontend (Vercel / Next.js)
# These NEXT_PUBLIC_* values are exposed to the browser and must be present at build time.
# ======================

# Backend API origin. The Next.js app proxies /api/* to this URL.
# Local: http://localhost:3001
# Production: the public URL of the API (not localhost).
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_API_VERSION=v1

# mock uses the in-app auth service. cognito uses AWS Cognito.
NEXT_PUBLIC_AUTH_PROVIDER=mock
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_REGION=us-east-1

# Public Mapbox token for map search and route drawing. Required for goal maps.
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_MAP_PROVIDER=mapbox

# Optional realtime. The current UI does not require Pusher.
NEXT_PUBLIC_PUSHER_APP_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=us2

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_USE_MOCK_SERVICES=true

# ======================
# Backend (not deployed by the Vercel frontend project)
# Host this API separately, or port the handlers later.
# ======================

# Postgres with PostGIS. On Vercel, use a Marketplace Postgres such as Neon,
# and enable PostGIS before applying packages/backend/prisma migrations.
DATABASE_URL=postgresql://postgres:password@localhost:5432/milequest_dev

# Required in production. Use a long random string. Do not reuse this placeholder.
JWT_SECRET=replace-with-a-long-random-string

# Server-side Mapbox token used by the Lambda geocoding handlers.
MAPBOX_ACCESS_TOKEN=

# Leave blank to use the mock auth provider.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
AWS_REGION=us-east-1

CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
