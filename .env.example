# Mile Quest environment template
# Copy to .env.local for local development. On Vercel, set the same keys in Project Settings.
# Never commit real secrets. Values below are placeholders.

# ======================
# App URL
# ======================

# Public site URL. Use the Vercel URL in production, for example https://your-project.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_PWA=true

# Optional. Leave empty so the browser calls this app's /api routes.
# Set an origin only if the API is hosted somewhere else that serves the same /api paths.
NEXT_PUBLIC_API_URL=

# ======================
# Database (Neon Postgres from the Vercel Marketplace)
# Plain Postgres is enough. This schema stores coordinates as JSON and distances as
# numbers. It does not use PostGIS.
# ======================

# Pooled connection string from Neon. Add ?sslmode=require if it is not already there.
# For Prisma on serverless, a pooled URL should also include pgbouncer=true&connection_limit=1.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1

# Direct (non-pooled) Neon connection string. Required for `prisma migrate deploy`.
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require

# ======================
# Auth
# Email and password are stored in Postgres. Access tokens are HS256 JWTs.
# Use a long random string of at least 16 characters. Do not reuse this placeholder.
# ======================

JWT_SECRET=replace-with-a-long-random-string
# Optional. Lower only for local tests. Production should stay at 10 or higher.
BCRYPT_ROUNDS=10

# ======================
# Mapbox
# The public token is used by the browser for map search and tiles.
# The secret token stays on the server and is used for walking directions when a goal is created.
# If MAPBOX_ACCESS_TOKEN is empty, goal distance falls back to a great-circle calculation.
# ======================

NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_MAP_PROVIDER=mapbox
MAPBOX_ACCESS_TOKEN=

# ======================
# Optional
# ======================

NEXT_PUBLIC_PUSHER_APP_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=us2
NEXT_PUBLIC_USE_MOCK_SERVICES=false
NODE_ENV=development
